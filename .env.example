# ---- API (Flask) ----
# Clave que los clientes envían en la cabecera x-api-key
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
CS1_API_LAB_1=<api-key>
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ---- Modelos (Azure Blob) ----
# URL SAS de solo lectura del contenedor "models"
MODELS_CONTAINER_URL=https://<cuenta>.blob.core.windows.net/models?<sas>

# ---- MQTT (consumer y publisher) ----
MQTT_HOST=localhost
MQTT_PORT=1883
API_URL=http://localhost:5000